{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap-xml"
    },
    {
      "source": "/",
      "destination": "/api/render"
    },
    {
      "source": "/:path*",
      "destination": "/api/render?path=:path*"
    }
  ],
  "functions": {
    "api/render.js": {
      "includeFiles": "content/**"
    },
    "api/articles.js": {
      "includeFiles": "content/**"
    },
    "api/sitemap-xml.js": {
      "includeFiles": "content/**"
    }
  }
}
